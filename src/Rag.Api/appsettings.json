{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=rag;Username=postgres;Password=postgres"
  },
  "OpenAI": {
    "ApiKey": "",
    "Endpoint": "",
    "ChatModel": "gpt-4o",
    "EmbeddingModel": "text-embedding-3-small"
  },
  "Auth": {
    "Authority": "",
    "Audience": "",
    "GroupClaim": "groups",
    "RequireHttpsMetadata": true
  },
  "RateLimiting": {
    "QueryPerMinute": 30,
    "UploadPerMinute": 10
  },
  "VectorStore": {
    "Provider": "Postgres"
  },
  "PgVector": {
    "Dimensions": 1536,
    "TableName": "document_embeddings",
    "TextSearchConfig": "english"
  },
  "Chunking": {
    "ChunkSize": 2000,
    "ChunkOverlap": 200
  },
  "Rag": {
    "TopK": 5,
    "RerankCandidateMultiplier": 4,
    "MinimumScore": 0,
    "VectorWeight": 0.7,
    "KeywordWeight": 0.3,
    "UseHybridSearchByDefault": false,
    "UseRerankingByDefault": false
  }
}
